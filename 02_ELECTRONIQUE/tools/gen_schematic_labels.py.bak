"""
BRC-M400 schematic generator.

Builds a hierarchical KiCad schematic from the netlist below, embedding the
REAL symbol definitions read from the installed KiCad libraries (so every pin
name/number is the library's, never hand-typed).

Run with KiCad's bundled Python:
    "C:\\Program Files\\KiCad\\10.0\\bin\\python.exe" gen_schematic.py

WARNING: regenerating OVERWRITES the .kicad_sch files. Use this to (re)build
the netlist before manual layout work; once you start editing the schematic in
the KiCad GUI, edit there instead.
"""
import copy
import math
import os
import sys
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from sexp import load, find_symbols, head, dump  # noqa: E402

PROJECT = "BRC-M400"
OUTDIR = os.path.normpath(os.path.join(HERE, "..", PROJECT))


def find_symdir():
    for v in ("10.0", "9.0", "8.0"):
        p = r"C:\Program Files\KiCad\%s\share\kicad\symbols" % v
        if os.path.isdir(p):
            return p
    raise SystemExit("KiCad symbol directory not found")


SYMDIR = find_symdir()
GRID = 2.54
STUB = 2.54

# ---------------------------------------------------------------------------
# Footprint shorthands
# ---------------------------------------------------------------------------
R0603 = "Resistor_SMD:R_0603_1608Metric"
R2512 = "Resistor_SMD:R_2512_6332Metric"
C0402 = "Capacitor_SMD:C_0402_1005Metric"
C0603 = "Capacitor_SMD:C_0603_1608Metric"
C0805 = "Capacitor_SMD:C_0805_2012Metric"
C1210 = "Capacitor_SMD:C_1210_3225Metric"
L0402 = "Inductor_SMD:L_0402_1005Metric"
L0603 = "Inductor_SMD:L_0603_1608Metric"
L0805 = "Inductor_SMD:L_0805_2012Metric"
SOT23 = "Package_TO_SOT_SMD:SOT-23"
SOT236 = "Package_TO_SOT_SMD:SOT-23-6"
JST_GH4 = "Connector_JST:JST_GH_SM04B-GHS-TB_1x04-1MP_P1.25mm_Horizontal"
JST_XH2 = "Connector_JST:JST_XH_B2B-XH-A_1x02_P2.50mm_Vertical"
TBD = "TBD-AN5457"


class Part:
    def __init__(self, ref, lib_id, value, fp, pins, mpn="", dnp=False):
        self.ref, self.lib_id, self.value, self.fp = ref, lib_id, value, fp
        self.pins = {str(k): v for k, v in pins.items()}
        self.mpn, self.dnp = mpn, dnp


def R(ref, val, a, b, fp=R0603, mpn=""):
    return Part(ref, "Device:R", val, fp, {1: a, 2: b}, mpn)


def C(ref, val, a, b, fp=C0603, mpn="", dnp=False):
    return Part(ref, "Device:C", val, fp, {1: a, 2: b}, mpn, dnp)


def L(ref, val, a, b, fp=L0402, mpn=""):
    return Part(ref, "Device:L", val, fp, {1: a, 2: b}, mpn)


def FLAG(ref, net):
    return Part(ref, "power:PWR_FLAG", "PWR_FLAG", "", {1: net})


# ---------------------------------------------------------------------------
# NETLIST — single source of truth. Net None = no-connect.
# ---------------------------------------------------------------------------
from netlist_revc import SHEETS, REVISION, ROOT_NOTES  # noqa: E402

# ---------------------------------------------------------------------------
# Library access + flattening of derived ("extends") symbols
# ---------------------------------------------------------------------------
_libs = {}


def lib(name):
    if name not in _libs:
        _libs[name] = find_symbols(load(os.path.join(SYMDIR, name + ".kicad_sym")))
    return _libs[name]


def _extends(node):
    for ch in node:
        if head(ch) == 'extends':
            return ch[1][1]
    return None


def _resolve(libname, symname):
    node = lib(libname)[symname]
    base = _extends(node)
    if base:
        attrs, props, subs = _resolve(libname, base)
        for s in subs:
            old = s[1][1]
            s[1] = ('STR', symname + old[len(base):])
    else:
        attrs, props, subs = [], {}, []
    for ch in node[2:]:
        h = head(ch)
        if h == 'extends':
            continue
        if h == 'property':
            props[ch[1][1]] = copy.deepcopy(ch)
        elif h == 'symbol':
            subs.append(copy.deepcopy(ch))
        elif h is not None:
            attrs = [a for a in attrs if head(a) != h] + [copy.deepcopy(ch)]
    return attrs, props, subs


# Library pin types that misrepresent the real part. TPS3808 RESET is open-drain
# (datasheet); the generic symbol types it push-pull "output" -> false ERC error.
PIN_TYPE_OVERRIDES = {("Power_Supervisor:TPS3808DBV", "1"): "open_collector"}


def _override_pin_types(lib_id, nodes):
    for node in nodes:
        for ch in node:
            if head(ch) == 'pin':
                num = next((s[1][1] for s in ch if head(s) == 'number'), None)
                t = PIN_TYPE_OVERRIDES.get((lib_id, num))
                if t:
                    ch[1] = ('SYM', t)
            elif isinstance(ch, list):
                _override_pin_types(lib_id, [ch])


def flat_symbol(lib_id):
    libname, symname = lib_id.split(':')
    attrs, props, subs = _resolve(libname, symname)
    _override_pin_types(lib_id, subs)
    tail = [a for a in attrs if head(a) == 'embedded_fonts']
    attrs = [a for a in attrs if head(a) != 'embedded_fonts']
    return [('SYM', 'symbol'), ('STR', lib_id)] + attrs + list(props.values()) + subs + tail


def symbol_pins(lib_id):
    """[(number, x, y, angle)] in library coordinates (Y up)."""
    node = flat_symbol(lib_id)
    out = []

    def walk(n):
        for ch in n:
            if isinstance(ch, list):
                if head(ch) == 'pin':
                    at = num = None
                    for sub in ch:
                        h = head(sub)
                        if h == 'at':
                            at = [float(t[1]) for t in sub[1:]]
                        elif h == 'number':
                            num = sub[1][1]
                    out.append((num, at[0], at[1], at[2] if len(at) > 2 else 0.0))
                else:
                    walk(ch)
    walk(node)
    return out


def symbol_props(lib_id):
    """{name: (x, y, angle, hidden)} from the library definition."""
    res = {}
    for ch in flat_symbol(lib_id):
        if head(ch) == 'property':
            x = y = a = 0.0
            hidden = False
            for sub in ch[3:]:
                if head(sub) == 'at':
                    vals = [float(t[1]) for t in sub[1:]]
                    x, y = vals[0], vals[1]
                    a = vals[2] if len(vals) > 2 else 0.0
                if head(sub) == 'effects':
                    s = repr(sub)
                    hidden = "'hide'" in s and "'yes'" in s or "('SYM', 'hide')]" in s
            res[ch[1][1]] = (x, y, a, hidden)
    return res


def symbol_prop_value(lib_id, name):
    for ch in flat_symbol(lib_id):
        if head(ch) == 'property' and ch[1][1] == name:
            return ch[2][1]
    return ""


# ---------------------------------------------------------------------------
# Emit helpers
# ---------------------------------------------------------------------------
def uid():
    return str(uuid.uuid4())


NS = uuid.uuid5(uuid.NAMESPACE_URL, "aeroday-v14/brc-m400")


def duid(key):
    """Deterministic UUID: stable across regenerations."""
    return str(uuid.uuid5(NS, key))


def n(v):
    s = "%.4f" % v
    s = s.rstrip('0').rstrip('.')
    return "0" if s in ("-0", "") else s


def q(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'


def snap(v):
    return round(v / GRID) * GRID


def outward(angle):
    """Unit vector (schematic coords, Y down) pointing AWAY from the body."""
    a = math.radians(angle + 180.0)
    dx, dy = round(math.cos(a)), -round(math.sin(a))
    return dx, dy


def label_angle(dx, dy):
    if dx > 0:
        return 0
    if dx < 0:
        return 180
    return 90 if dy < 0 else 270


def text_len(s):
    return 1.15 * len(s) + 3.0


def effects(size=1.27, justify=None, hide=False):
    j = " (justify %s)" % justify if justify else ""
    h = " (hide yes)" if hide else ""
    return "(effects (font (size %s %s))%s%s)" % (n(size), n(size), j, h)


class Sheet:
    def __init__(self, name, title, notes, parts, root_uuid, sheet_uuid, page):
        self.name, self.title, self.notes, self.parts = name, title, notes, parts
        self.root_uuid, self.sheet_uuid, self.page = root_uuid, sheet_uuid, page
        self.uuid = uid()
        self.items = []
        self.lib_ids = set()
        self.path = "/%s/%s" % (root_uuid, sheet_uuid)


def build_sheet(sh, global_nets, counters):
    # --- measure parts
    metas = []
    for p in sh.parts:
        pins = symbol_pins(p.lib_id)
        pinmap = {num: (x, -y, a) for num, x, y, a in pins}  # schematic-relative
        missing = set(p.pins) - set(pinmap)
        if missing:
            raise SystemExit("%s: pins %s not in symbol %s" % (p.ref, missing, p.lib_id))
        unused = set(pinmap) - set(p.pins)
        if unused:
            raise SystemExit("%s: symbol pins %s not assigned (use None for NC)" % (p.ref, unused))
        xs, ys = [0.0], [0.0]
        for num, (x, y, a) in pinmap.items():
            xs.append(x)
            ys.append(y)
            net = p.pins[num]
            if net is None:
                continue
            dx, dy = outward(a)
            ext = STUB + (4.0 if net == "GND" else text_len(net))
            xs.append(x + dx * ext)
            ys.append(y + dy * ext)
        # text margin for reference/value (small parts print them to the right)
        minx, maxx = min(xs) - 3, max(xs) + 3
        if len(pinmap) <= 4:
            maxx += 1.2 * max(len(p.value), len(p.ref))
        miny, maxy = min(ys) - 4, max(ys) + 4
        metas.append((p, pinmap, minx, maxx, miny, maxy))

    # --- choose paper and shelf-pack
    for paper, (W, H) in (("A3", (420, 297)), ("A2", (594, 420)), ("A1", (841, 594))):
        x0, y0 = 15.0, 25.0 + 6.0 * len(sh.notes)
        x, y, rowh = x0, y0, 0.0
        places = []
        ok = True
        for (p, pinmap, minx, maxx, miny, maxy) in metas:
            w, h = maxx - minx, maxy - miny
            if x + w > W - 15:
                x, y, rowh = x0, y + rowh + 14, 0.0
            places.append((snap(x - minx), snap(y - miny)))
            x += w + 9
            rowh = max(rowh, h)
        if y + rowh > H - 40:
            ok = False
        if ok:
            break
    sh.paper = paper

    out = []
    # title + notes
    out.append('(text %s (exclude_from_sim no) (at 15 14 0) %s (uuid %s))' % (
        q(sh.title.upper()), effects(3.0, "left bottom"), q(uid())))
    for i, line in enumerate(sh.notes):
        out.append('(text %s (exclude_from_sim no) (at 15 %s 0) %s (uuid %s))' % (
            q(line), n(21 + 6 * i), effects(1.8, "left bottom"), q(uid())))

    for (meta, (ox, oy)) in zip(metas, places):
        p, pinmap = meta[0], meta[1]
        sh.lib_ids.add(p.lib_id)
        lprops = symbol_props(p.lib_id)
        is_flag = p.lib_id == "power:PWR_FLAG"
        fields = [
            ("Reference", p.ref, not is_flag and True),
            ("Value", p.value, True),
            ("Footprint", p.fp, False),
            ("Datasheet", symbol_prop_value(p.lib_id, "Datasheet"), False),
            ("Description", symbol_prop_value(p.lib_id, "Description"), False),
        ]
        if p.mpn:
            fields.append(("MPN", p.mpn, False))
        props_txt = []
        for (name, val, visible) in fields:
            lx, ly, la, _ = lprops.get(name, (0.0, 0.0, 0.0, True))
            if name == "MPN":
                lx, ly = 0.0, 0.0
            if is_flag and name == "Reference":
                visible = False
            props_txt.append('(property %s %s (at %s %s %s) %s)' % (
                q(name), q(val), n(ox + lx), n(oy - ly), n(la),
                effects(1.27, None, not visible)))
        pins_txt = ' '.join('(pin %s (uuid %s))' % (q(num), q(uid())) for num in pinmap)
        out.append(
            '(symbol (lib_id %s) (at %s %s 0) (unit 1) (exclude_from_sim no) (in_bom %s) '
            '(on_board %s) (dnp %s) (uuid %s) %s %s (instances (project %s (path %s '
            '(reference %s) (unit 1)))))' % (
                q(p.lib_id), n(ox), n(oy),
                "no" if is_flag or p.lib_id.startswith("Mechanical:") else "yes",
                "no" if is_flag else "yes", "yes" if p.dnp else "no", q(duid("sym:" + p.ref)),
                ' '.join(props_txt), pins_txt, q(PROJECT), q(sh.path), q(p.ref)))

        # pins -> stubs + labels / power symbols / no-connects
        for num, (px, py, a) in pinmap.items():
            X, Y = ox + px, oy + py
            net = p.pins[num]
            if net is None:
                out.append('(no_connect (at %s %s) (uuid %s))' % (n(X), n(Y), q(uid())))
                continue
            dx, dy = outward(a)
            EX, EY = X + dx * STUB, Y + dy * STUB
            out.append('(wire (pts (xy %s %s) (xy %s %s)) (stroke (width 0) (type default)) (uuid %s))' % (
                n(X), n(Y), n(EX), n(EY), q(uid())))
            if net == "GND":
                counters['pwr'] += 1
                ref = "#PWR%03d" % counters['pwr']
                sh.lib_ids.add("power:GND")
                out.append(
                    '(symbol (lib_id "power:GND") (at %s %s 0) (unit 1) (exclude_from_sim no) '
                    '(in_bom yes) (on_board yes) (dnp no) (uuid %s) '
                    '(property "Reference" %s (at %s %s 0) %s) '
                    '(property "Value" "GND" (at %s %s 0) %s) '
                    '(property "Footprint" "" (at %s %s 0) %s) '
                    '(property "Datasheet" "" (at %s %s 0) %s) '
                    '(property "Description" "" (at %s %s 0) %s) '
                    '(pin "1" (uuid %s)) (instances (project %s (path %s (reference %s) (unit 1)))))' % (
                        n(EX), n(EY), q(duid("pwr:" + ref)),
                        q(ref), n(EX), n(EY + 6.35), effects(1.27, None, True),
                        n(EX), n(EY + 3.81), effects(1.27),
                        n(EX), n(EY), effects(1.27, None, True),
                        n(EX), n(EY), effects(1.27, None, True),
                        n(EX), n(EY), effects(1.27, None, True),
                        q(uid()), q(PROJECT), q(sh.path), q(ref)))
                continue
            ang = label_angle(dx, dy)
            just = "left" if ang in (0, 90) else "right"
            if net in global_nets:
                out.append(
                    '(global_label %s (shape passive) (at %s %s %d) (fields_autoplaced yes) %s (uuid %s) '
                    '(property "Intersheetrefs" "${INTERSHEET_REFS}" (at %s %s 0) %s))' % (
                        q(net), n(EX), n(EY), ang, effects(1.27, just), q(uid()),
                        n(EX), n(EY), effects(1.27, just, True)))
            else:
                out.append('(label %s (at %s %s %d) (fields_autoplaced yes) %s (uuid %s))' % (
                    q(net), n(EX), n(EY), ang, effects(1.27, just + " bottom"), q(uid())))
    sh.items = out


def lib_symbols_block(lib_ids):
    return '(lib_symbols\n' + '\n'.join(dump(flat_symbol(l), 1) for l in sorted(lib_ids)) + '\n)'


def title_block(title, page_comment):
    return ('(title_block (title %s) (date "2026-11-21") (rev %s) (company "INSATECH - AeroDay V14 - Challenge CAO") '
            '(comment 1 "BRC-M400 - Buoy Release & Beacon Controller") (comment 2 %s))' % (q(title), q(REVISION), q(page_comment)))


def write_sheet(sh):
    body = [
        '(kicad_sch (version 20250610) (generator "eeschema") (generator_version "10.0")',
        '(uuid %s)' % q(sh.sheet_file_uuid),
        '(paper %s)' % q(sh.paper),
        title_block(sh.title, "Feuille %s" % sh.page),
        lib_symbols_block(sh.lib_ids),
    ] + sh.items + ['(embedded_fonts no)', ')']
    with open(os.path.join(OUTDIR, sh.name + ".kicad_sch"), "w", encoding="utf-8", newline="\n") as f:
        f.write('\n'.join(body) + '\n')


def write_root(root_uuid, sheets):
    out = [
        '(kicad_sch (version 20250610) (generator "eeschema") (generator_version "10.0")',
        '(uuid %s)' % q(root_uuid),
        '(paper "A3")',
        title_block("BRC-M400 - Synoptique", "Feuille 1 - racine hierarchique"),
        '(lib_symbols)',
    ]
    notes = ROOT_NOTES
    for i, line in enumerate(notes):
        out.append('(text %s (exclude_from_sim no) (at 20 %s 0) %s (uuid %s))' % (
            q(line), n(25 + 7 * i), effects(3.0 if i == 0 else 2.0, "left bottom"), q(uid())))
    x, y = 20.0, 100.0
    for i, sh in enumerate(sheets):
        w, h = 80.0, 30.0
        cx = x + (i % 3) * (w + 30)
        cy = y + (i // 3) * (h + 30)
        out.append(
            '(sheet (at %s %s) (size %s %s) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) '
            '(stroke (width 0.1524) (type solid)) (fill (color 0 0 0 0.0000)) (uuid %s) '
            '(property "Sheetname" %s (at %s %s 0) %s) '
            '(property "Sheetfile" %s (at %s %s 0) %s) '
            '(instances (project %s (path %s (page %s)))))' % (
                n(cx), n(cy), n(w), n(h), q(sh.sheet_uuid),
                q(sh.title), n(cx), n(cy - 0.8), effects(1.8, "left bottom"),
                q(sh.name + ".kicad_sch"), n(cx), n(cy + h + 0.6), effects(1.27, "left top"),
                q(PROJECT), q("/" + root_uuid), q(str(sh.page))))
    out += ['(sheet_instances (path "/" (page "1")))', '(embedded_fonts no)', ')']
    with open(os.path.join(OUTDIR, PROJECT + ".kicad_sch"), "w", encoding="utf-8", newline="\n") as f:
        f.write('\n'.join(out) + '\n')


def write_project():
    path = os.path.join(OUTDIR, PROJECT + ".kicad_pro")
    if os.path.exists(path):
        return  # never clobber settings the user changed in KiCad
    pro = '{\n  "meta": {\n    "filename": "%s.kicad_pro",\n    "version": 3\n  }\n}\n' % PROJECT
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(pro)


def main():
    os.makedirs(OUTDIR, exist_ok=True)
    root_uuid = duid("root")
    # nets that appear on more than one sheet -> global labels
    where = {}
    for name, _, _, parts in SHEETS:
        for p in parts:
            for net in p.pins.values():
                if net:
                    where.setdefault(net, set()).add(name)
    global_nets = {k for k, v in where.items() if len(v) > 1}
    try:
        from netlist_revc import GLOBAL_NETS
        rogue = sorted(global_nets - GLOBAL_NETS)
        if rogue:
            raise SystemExit("Undeclared cross-sheet nets (name collision?): %s" % rogue)
    except ImportError:
        pass
    # single-pin nets are suspicious (except NC / flags / holes)
    count = {}
    for _, _, _, parts in SHEETS:
        for p in parts:
            for net in p.pins.values():
                if net:
                    count[net] = count.get(net, 0) + 1
    lonely = sorted(k for k, v in count.items() if v < 2)
    if lonely:
        print("WARNING single-connection nets:", lonely)

    refs = [p.ref for _, _, _, parts in SHEETS for p in parts]
    dup = {r for r in refs if refs.count(r) > 1}
    if dup:
        raise SystemExit("Duplicate references: %s" % sorted(dup))

    counters = {'pwr': 0}
    sheets = []
    for i, (name, title, notes, parts) in enumerate(SHEETS):
        sh = Sheet(name, title, notes, parts, root_uuid, duid("sheet:" + name), i + 2)
        sh.sheet_file_uuid = duid("file:" + name)
        build_sheet(sh, global_nets, counters)
        write_sheet(sh)
        sheets.append(sh)
        print("  %-10s %-4s %3d parts  -> %s.kicad_sch" % (name, sh.paper, len(parts), name))
    write_root(root_uuid, sheets)
    write_project()
    print("Global nets (%d): %s" % (len(global_nets), ', '.join(sorted(global_nets))))
    print("Written to", OUTDIR)


if __name__ == "__main__":
    main()
