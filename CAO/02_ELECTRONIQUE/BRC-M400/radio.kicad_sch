(text "RADIO LORA SEMTECH SX1262 - 868 MHZ" (exclude_from_sim no) (at 15 14 0) (effects (font (size 3 3)) (justify left bottom)) (uuid "3e20f615-1bca-42a0-a17e-2b76fef58593"))
(text "SX1262 : +22 dBm, -148 dBm de sensibilite, 4,6 mA en RX. Topologie = design de reference Semtech E449V01A (AN1200.40)." (exclude_from_sim no) (at 15 21 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "2c53dc73-f6d0-4016-b426-66b9b3f5dd0d"))
(text "Option C du datasheet : DC-DC pour le coeur (L20 15 uH entre DCC_SW et VREG), VDD_IN alimente par VBAT pour le PA." (exclude_from_sim no) (at 15 27 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "6422486b-a4c2-471c-923b-5d2a9654e7f6"))
(text "TCXO 32 MHz sinus ecrete alimente par DIO3 (SetDIO3AsTCXOCtrl), relie a XTA par 220 Ohm + 10 pF ; XTB en l'air (datasheet 4.1.4)." (exclude_from_sim no) (at 15 33 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "9c0c1bb6-0644-450f-8e14-30f6a71a9b0d"))
(text "TX : L22/C59 adaptation, L23//C60 rejecteur H2, pi C61-L24-C63, C62 blocage DC. RX : balun C64/L25/C66 (+C65 option)." (exclude_from_sim no) (at 15 39 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "bec2a61b-8aeb-4f09-be2e-1f0ac59ff9d6"))
(text "!! Valeurs TUNE = nomenclature regionale Semtech E449V01A (sur demande) puis accord a l'analyseur de reseau." (exclude_from_sim no) (at 15 45 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "7278938c-5f11-4ba2-8f25-77efa139abf9"))
(text "AS179-92LF : V1 <- DIO2 (SetDIO2AsRfSwitchCtrl, 1 en TX) ; V2 <- RF_RXEN. Verifier la table de verite Skyworks." (exclude_from_sim no) (at 15 51 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "e01b4430-d2f2-4872-96df-9d2a42e0c05b"))
